  "components": {
    "securitySchemes": {
      "sesion": {
        "type": "apiKey",
        "in": "cookie",
        "name": "PETMATCH_SESSION",
        "description": "Cookie de sesión de esta base y demostración. La conexión con A real se documenta en docs/INTEGRACION_B01.md; A publica actualmente JWT Bearer."
      }
    },
    "schemas": {
      "CrearMascotaSolicitud": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nombre",
          "especie",
          "edadEstimadaMeses",
          "tamano",
          "energia",
          "comportamientoIds"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Se recortan extremos antes de validar. Límite en puntos de código Unicode."
          },
          "especie": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,29}$",
