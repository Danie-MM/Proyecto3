{
  "openapi": "3.1.0",
  "info": {
    "title": "PetMatchCR · Comprobación de entorno G-02",
    "version": "1.0.0",
    "description": "Ruta técnica para desarrollo local y pruebas."
  },
  "paths": {
    "/api/v1/pruebas-entorno": {
      "post": {
        "operationId": "crearPrueba",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Solicitud"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registro guardado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registro"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error de persistencia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pruebas-entorno/{id}": {
      "get": {
        "operationId": "consultarPrueba",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Registro recuperado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registro"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Registro inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error de persistencia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Solicitud": {
        "type": "object",
        "required": [
          "texto"
        ],
        "additionalProperties": false,
        "properties": {
          "texto": {
            "type": "string",
            "description": "El texto debe tener entre 1 y 80 caracteres una vez recortados los extremos."
          }
        }
      },
      "Registro": {
        "type": "object",
        "required": [
          "id",
          "texto",
          "creadoEn"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "texto": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "creadoEn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "codigo",
          "mensaje",
          "erroresCampos",
          "trazaId"
        ],
        "properties": {
          "codigo": {
            "type": "string"
          },
          "mensaje": {
            "type": "string"
          },
          "erroresCampos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "campo",
                "mensaje"
              ],
              "properties": {
                "campo": {
                  "type": "string"
                },
                "mensaje": {
                  "type": "string"
                }
              }
            }
          },
          "trazaId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
